<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="first-use-local" value="../feed" />
  </packageSources>
  <packageSourceMapping>
    <clear />
    <packageSource key="first-use-local"><package pattern="FactsPDF" /></packageSource>
  </packageSourceMapping>
  <fallbackPackageFolders><clear /></fallbackPackageFolders>
</configuration>
