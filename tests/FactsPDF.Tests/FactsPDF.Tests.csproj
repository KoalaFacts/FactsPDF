<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Every library target is tested. The CLI ships on net10.0 only, so the other targets compile its
         front end (CliApplication) into the test assembly instead of referencing the CLI project. -->
    <TargetFramework></TargetFramework>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>
  <ItemGroup>
    <None Include="../../examples/report-cell-text-flow*.html" Link="examples/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../examples/report-cell-relative-padding*.html" Link="examples/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../examples/report-cell-text-indent*.html" Link="examples/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../examples/report-table-relative-tracks*.html" Link="examples/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../examples/report-overflow-wrap*.html" Link="examples/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../examples/report-word-break-identifiers*.html" Link="examples/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../fixtures/jpeg/**" Link="jpeg/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../fixtures/tables-e1/**" Link="tables-e1/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Compile Include="../../probes/browser-wasm/ProbeConversion.cs" Link="WasmProbe/ProbeConversion.cs" />
    <Compile Include="../../shared/PageFurnitureJson.cs" Link="Configuration/PageFurnitureJson.cs" />
    <Compile Include="../../shared/ExtensionsToString.cs" Link="Text/ExtensionsToString.cs" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.6.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.8.1" />
    <PackageReference Include="NUnit" Version="4.6.1" />
    <PackageReference Include="NUnit3TestAdapter" Version="6.2.0" />
    <ProjectReference Include="../../src/FactsPDF/FactsPDF.csproj" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <ProjectReference Include="../../src/FactsPDF.Cli/FactsPDF.Cli.csproj" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' != 'net10.0'">
    <Compile Include="../../src/FactsPDF.Cli/CliApplication.cs" Link="Cli/CliApplication.cs" />
  </ItemGroup>
</Project>
